################################################################################
## QNX hypervisor GUEST image -- TEMPLATE.
##
## Modelled on qnx_guests/images/guest-1/qnx800-guest-1.build.
##
## Note how little boot configuration appears here: a guest is loaded by qvm at
## a high address as ELF with the generic startup, which is exactly what
## meta-qnx defaults to. The host image had to override every one of those; this
## one overrides none.
##
## Everything unqualified resolves from $QNX_TARGET. Applications arrive through
## QNX_IFS_INSTALL in the recipe.
################################################################################

#include qnx-boot.build.inc

[+script] startup-script = {
#include qnx-startup-preamble.build.inc

    ############################################################################
    ## Console. The virtio-console vdev the host gives this guest -- loc and
    ## intr must match the guest's .qvmconf.
    ############################################################################
    devc-virtio @QNX_GUEST_CONSOLE@
    waitfor /dev/vcon1 4
    reopen /dev/vcon1

    display_msg " "
    ksh -c "echo Welcome to QNX $(uname -r) on $(uname -m)"
    display_msg " "

    ############################################################################
    ## Networking over virtio-net, to the host and to the other guest.
    ############################################################################
    display_msg "Starting networking ..."
    io-sock -m phy -m fdt -d vtnet_mmio
    waitfor /dev/socket 10

    ## Addressing moved into a script because the startup interpreter cannot
    ## wait for anything or test whether a step worked -- see .net-start.sh.
    /proc/boot/.net-start.sh

    ############################################################################
    ## SPI and GPIO, on hardware passed straight through by the .qvmconf.
    ##
    ## The RP1's SPI0 and GPIO register windows are mapped into this guest, so
    ## these are the same drivers the host would run against the same silicon --
    ## which is also why only one side may drive them at a time.
    ##
    ## rpi-gpio cannot identify the board under a hypervisor: it reads the model
    ## from uname, and gets qvm's answer rather than the Pi's. RPI_GPIO_FORCE_MODEL
    ## is what the application added for exactly this, and without it the resource
    ## manager starts, fails to recognise the platform, and /dev/gpio never
    ## appears.
    ############################################################################
    display_msg "Starting SPI master driver ..."
    gpio-rp1 set 7-8 a0 pu
    gpio-rp1 set 9-11 a0 pd
    spi-dwc -c /var/spi.conf
    waitfor /dev/io-spi

    display_msg "Starting GPIO resource manager ..."
    RPI_GPIO_FORCE_MODEL=RaspberryPi5 rpi-gpio &
    waitfor /dev/gpio

    ############################################################################
    ## Data disk (rootfs.img) -- union-mounted at /.
    ##
    ## Everything too large for this RAM-resident IFS lives on a virtio-blk disk
    ## the host attaches: the Qt cluster deploy tree today, the graphics stack
    ## and SOME/IP libraries as they come online. Mounted here, before any of it
    ## is used, so every path resolves as if the files were baked into the image.
    ## A guest booted without the disk present logs an error and carries on.
    ############################################################################
    /proc/boot/.rootfs-mount.sh

    ############################################################################
    ## SSH daemon.
    ##
    ## The guest installs qnx-ssh, so sshd and its helpers were already in the
    ## image -- nothing started them. `ssh root@10.0.0.2` from the host answered
    ## "Connection refused", which reads as a network fault and is not one; the
    ## reference guest starts it and this did not.
    ##
    ## AFTER the data disk is mounted, deliberately: the host keys live in
    ## /var/ssh on that disk. Started before it, ssh-server.sh would wait out its
    ## full QNX_SSH_KEYDIR_WAIT, fall back to keys in RAM, and hand the guest a
    ## new identity on every boot.
    ############################################################################
    ############################################################################
    ## Pseudo-terminals, which sshd needs before it can give anyone a shell.
    ##
    ## The binary was already in this image and nothing started it, so an ssh
    ## login got as far as authenticating and then:
    ##
    ##     PTY allocation request failed on channel 0
    ##
    ## which leaves a session with no terminal -- commands run, but nothing that
    ## wants a tty works. Before sshd, so it is there when the first connection
    ## arrives rather than a second later.
    ############################################################################
    display_msg "Starting devc-pty manager ..."
    devc-pty

    display_msg "Starting SSH daemon ..."
    ## on -p, not a bare "&". sshd inherits it, and so does every session it
    ## forks -- which is the point.
    ##
    ## An ssh key exchange is CPU, and it is CPU *in here*, competing with what
    ## this guest is for: a software-rendered Qt cluster and the motor apps,
    ## all at the default priority of 10. One of the two vCPUs is not even in
    ## the running -- motor_data_producer pins itself to CPU 0 and polls SPI:
    ##
    ##     [ctrl] pinned to CPU 0
    ##
    ## so a handshake queues behind the cluster on whatever is left. From the
    ## host that shows up as ssh taking a long time to produce a prompt, and to
    ## hms -- which pays a handshake per Monitor poll -- as the guest half of
    ## the page timing out while the guest is otherwise perfectly healthy.
    ##
    ## Above the workload, below the drivers. Management access to a busy board
    ## is worth more than a few frames of the cluster, and this is the same call
    ## made on the host for hms.
    on -p @QNX_GUEST_SSHD_PRIORITY@ /proc/boot/.ssh-server.sh &

    ############################################################################
    ## Applications, ordered by QNX_IFS_STARTUP_AFTER dependencies.
    ############################################################################
@QNX_IFS_STARTUP@

    ############################################################################
    ## The demo, started at boot.
    ##
    ## The reference guest leaves this to a command typed at the shell, because
    ## the graphics step needs the host's Screen to already be up and a guest
    ## cannot check for that or wait on it. Starting it here accepts that race
    ## rather than avoiding it: graphics-virtio-start.sh retries, so a guest that
    ## wins the race comes up with the cluster on the panel, and one that loses
    ## it reports the retries and can be restarted by hand with the same script.
    ##
    ## Backgrounded, and this matters -- the script ends in `exec sh run.sh`,
    ## which never returns. In the foreground it would take the boot script with
    ## it and the login shell below would never start, leaving a guest with a
    ## cluster and no console.
    ############################################################################
    display_msg "Starting the cluster demo ..."
    /scripts/start-guest1.sh &

    display_msg "Re-run /scripts/start-guest1.sh if the panel stays dark"
    display_msg "Other vdevs have scripts of their own: block-start.sh,"
    display_msg "shmem-start.sh, watchdog-start.sh and watchdog-stop.sh"

    display_msg "Starting shell ..."
    [+session] ksh &
}

[uid=0 gid=0]

################################################################################
## Mount the guest data disk (rootfs.img) at /.
##
## rootfs.img is attached by qnx-guest.qvmconf as a virtio-blk vdev. smem= and
## irq= here must match that vdev's loc/intr, which is why both come from the
## same two variables in meta-qnx-guest/conf/qnx-guest-vdevs.inc rather than
## being written out twice. The whole device is the filesystem -- there is no
## partition table -- so it is mounted as /dev/vblk0 directly, not a
## /dev/vblk0tNNN partition.
##
## An external file would need a repo path; this is short and self-contained, so
## it is written inline. It contains no '}' or '${...}', which an inline mkifs
## block cannot carry.
################################################################################
################################################################################
## Network addressing.
##
## A script rather than four lines in the startup block, because those four
## lines could not wait and could not tell whether they had worked:
##
##     Starting networking ...
##     ifconfig: interface vtnet0 does not exist
##     route: writing to routing socket: Network is unreachable
##
## io-sock returning, and /dev/socket appearing, do not mean the virtio-net
## devices have attached. The driver enumerates them afterwards, and each one is
## a negotiation with a vdev thread in qvm on the other side of the virtual
## wire -- so how long it takes is a property of how loaded the host is, not of
## this guest. Configuring the interface immediately is a race, and the startup
## script lost it silently: ifconfig failed, route failed, nothing retried, and
## the guest ran the rest of its life with no network. Every later symptom --
## MQTT unreachable, no SOME/IP, no ssh -- is that one lost race.
##
## if_up -p waits for presence, which is exactly the missing step. The host
## image already learned this for its wifi radio, for the same reason.
##
## No closing brace and no dollar-brace anywhere below: this is an inline mkifs
## block, and either one ends it early.
################################################################################
[perms=0744] /proc/boot/.net-start.sh = {
#!/bin/ksh

HOST_IF=vtnet0
PEER_IF=vtnet1

# The other end of the host's vp0. The host routes and NATs this network, so it
# is also the default gateway -- see .vdev_net_start.sh and pf-nat.conf in the
# host image.
echo "net: waiting for $HOST_IF ..."
if ! if_up -p -r 20 $HOST_IF; then
    echo "net: $HOST_IF never appeared. The virtio-net vdevs come from the"
    echo "net: qvmconf on the host and are found through the FDT qvm generates,"
    echo "net: so check that the host declared them and that io-sock loaded"
    echo "net: devs-vtnet_mmio. Interfaces that did appear:"
    ifconfig -l
    echo "net: the stack's own account of it:"
    slog2info | tail -30
    exit 1
fi

ifconfig $HOST_IF @QNX_GUEST_IP@ netmask 255.255.255.0 up
route add default @QNX_GUEST_GATEWAY@

# The guest_to_guest vdev: a direct wire to the Linux guest, with no host in
# between and so no gateway. This is the link motor_ai_client talks to
# motor_ai_server over -- both vsomeip configs name these addresses literally,
# so this and network-setup.sh in meta-bmo have to agree.
#
# Not fatal on its own: a guest that can reach the host but not its sibling is
# still worth having, and saying so beats a silent half-configured stack.
if if_up -p -r 10 $PEER_IF; then
    ifconfig $PEER_IF @QNX_GUEST_PEER_IP@ netmask 255.255.255.0 up
else
    echo "net: $PEER_IF never appeared -- SOME/IP to the Linux guest is down"
fi

echo "net: up"
ifconfig -l
}

[perms=0744] /proc/boot/.rootfs-mount.sh = {
#!/bin/ksh
echo "Starting virtio block driver for the data disk ..."
devb-virtio virtio smem=@QNX_GUEST_ROOTFS_LOC@,irq=@QNX_GUEST_ROOTFS_INTR@ disk name=vblk

if waitfor /dev/vblk0 10
then
    mount -t qnx6 /dev/vblk0 /
    if test -f /qt-cluster/run.sh
    then
        echo "Data disk mounted at / (Qt cluster and payloads available)"
    else
        echo "ERROR: data disk mounted but /qt-cluster is missing -- rebuild rootfs.img"
    fi
else
    echo "ERROR: /dev/vblk0 never appeared -- is rootfs.img present next to the .qvmconf?"
fi
}

################################################################################
## Bring up the cluster demo, in the order the pieces need each other.
##
## This is the reference guest's /scripts/start-guest1.sh. It is one script and
## not five boot-script lines because every step here can fail for a reason
## worth reading, and because it is run after the host is known to be ready --
## the graphics step needs the host's Screen already up, which the guest cannot
## check for and the host cannot promise at any particular time.
##
## Order matters and the sleeps are the reference's:
##   producer first, since the client reads the shared memory it creates
##   client next, one second later, so the segment exists before it looks
##   graphics last, because Qt needs /dev/screen before it can open a window
##
## The Qt tree is at /qt-cluster (from rootfs.img), not the monorepo's
## /QT_Demo_APP -- run.sh resolves its own directory, so the tree relocated
## cleanly and only this path had to follow it.
##
## graphics-virtio-start.sh keeps its output, unlike the reference, which sent
## it to /dev/null. It is the step that retries, and the one whose failure looks
## from the outside like nothing more than a screen that stays dark.
##
## No '}' and no '${...}' anywhere below: an inline mkifs block cannot carry
## either, and a stray brace silently ends the block.
################################################################################
[perms=0744] /scripts/start-guest1.sh = {
#!/bin/sh

echo "=== Starting motor_data_producer ==="
motor_data_producer /etc/motor/config.json &

sleep 1

echo "=== Starting motor_recorder ==="
# -d is where the CSVs go. /record is a directory on the data disk, created by
# qnx-guest-rootfs, because the IFS is read-only and /tmp -- the recorder's own
# default -- is RAM here, so anything written there is gone at the next reboot.
#
# mkdir anyway: the disk is union-mounted at /, and a guest booted without it
# has no /record at all. Without this the recorder starts, fails on every write
# and says so once per file.
mkdir -p /record
motor_recorder -d /record &

sleep 1

echo "=== Starting motor_ai_client ==="
export VSOMEIP_CONFIGURATION=/Motor_AI_Client/vsomeip.json
/Motor_AI_Client/motor_ai_client >/dev/null 2>&1 &

sleep 1

echo "=== Starting graphics ==="
# In the foreground and its result checked, because the cluster cannot start
# without it. graphics-virtio-start.sh does the waiting itself -- it blocks on
# /dev/dri/card0, then relaunches screen up to five times to get past an EGL
# race with the freshly-attached virtio-gpu -- and returns non-zero when
# /dev/screen never appears.
#
# Ignoring that was the bug: Qt would start anyway, find no Screen, and fail at
# the point it tried to open a window. The failure then reads as a Qt problem
# and is not one, and the real message has already scrolled past.
if ! /scripts/graphics-virtio-start.sh; then
    echo "ERROR: graphics did not come up -- NOT starting the cluster."
    echo "       Check the host is running Screen: the GPU vdev gates its EGL"
    echo "       context on the host's, and qvm exits if a guest asks first."
    echo "       Then re-run /scripts/start-guest1.sh"
    exit 1
fi

echo "=== Starting the Qt cluster ==="
cd /qt-cluster && exec sh run.sh >/dev/null 2>&1
}

################################################################################
## Board binaries, from the two BSPs this image installs.
##
## Named here rather than harvested: a BSP ships far more than any one image
## should carry, so both BSP recipes set QNX_IFS_AUTO_ENTRIES = "0" and leave
## the choosing to whoever installs them.
##
##   gpio-rp1 / spi-dwc   drive the RP1 windows passed through by the .qvmconf
##   shmem-guest          the shmem vdev's demo utility
##   wdtkick              starts and kicks the wdt-sp805 vdev
##   io                   reads and writes a physical address, which is how
##                        watchdog-stop.sh disables the timer. NOT in the QNX 8
##                        SDP -- optional so the image still builds, and
##                        watchdog-stop.sh checks for it rather than assuming.
##                        The reference guest has the same gap.
################################################################################
/bin/gpio-rp1=gpio-rp1
/sbin/spi-dwc=spi-dwc
/bin/wdtkick=wdtkick
[+optional] /bin/io=io

# shmem-guest has no leading slash, which in mkifs means /proc/boot -- where the
# reference guest has it. Written this way rather than as /proc/boot/shmem-guest
# because that is the spelling the reference uses and mkifs's own default.
shmem-guest=shmem-guest

################################################################################
## The SPI bus, as this guest sees it.
##
## NOT the host's spi.conf, though it describes the same SPI0. The interrupt is
## the guest's side of the pass-through mapping (the host's is 179), and the
## clocks and word width differ -- copying the host's file over this one gets a
## bus that initialises and transfers nothing.
##
## dma_thld is a uint8_t, so 255 is the largest value that fits and forces PIO;
## 65536 wraps to 0 and turns DMA on for every transfer, which is the opposite
## of what it looks like it says.
##
## clock_rate and idle_insert are set for motor_data_producer, which is the only
## thing on this bus. It reads a 4828-byte frame from the STM32 every 10 ms
## (20 kHz / 200 rows), so the link has to carry 3.86 Mbit/s sustained with
## enough margin left for the read to finish inside the block period.
##
## At the previous 5 MHz with idle_insert=1 it did not. idle_insert adds a clock
## between words, so a byte costs 9 bit-times rather than 8, and the frame took
## 4828 * 9 / 5e6 = 8.69 ms of a 10 ms budget -- measured 8.55 ms on the board.
## Every cycle that jittered past 10 ms lost a block: ~12 of every 100, with the
## STM32 overwriting the frame it could not ship.
##
## 8 MHz without idle_insert puts the frame at 4828 * 8 / 8e6 = 4.83 ms, which is
## the rate motor_wire.h says the firmware was designed around ("the link was
## raised 4 -> 8 MHz at v4"). Do not raise this without watching the producer's
## crc= counter: past ~8 MHz the bench jumper wiring is what fails first, and
## the STM32 side has not been validated higher.
##
## Keep in step with spi_clock_hz / spi_idle_insert in the producer's
## config.json (see motor-data-producer_1.0.bb). On a mismatch the producer
## tries to rewrite this file and bounce spi-dwc at every startup.
################################################################################
/var/spi.conf = {
[globals]
verbose=5

[bus]
busno=0
name=spi0
base=0x1f00050000
irq=@QNX_GUEST_SPI_INTR@
input_clock=500000000
dma_thld=255

[dev]
parent_busno=0
devno=0
name=dev0
clock_rate=8000000
cpha=0
cpol=0
bit_order=msb
word_width=8
idle_insert=0
}

################################################################################
## Scripts for the vdevs that are not brought up at boot.
##
## Each one exists because its vdev is offered by the .qvmconf and would
## otherwise be dead hardware. They are not started automatically for the same
## reason the reference guest does not start them: each claims a device, and a
## guest being used for something else should not have them running.
##
## The addresses are markers rather than literals precisely because they appear
## in the .qvmconf too -- see qnx-guest-vdevs.inc.
##
## No '}' and no '${...}' in any of these: an inline mkifs block cannot carry
## either, and a stray brace silently ends the block.
################################################################################
[perms=0755] /scripts/shmem-start.sh = {
#!/bin/sh
# The loc and intr the shmem vdev was given.
shmem-guest @QNX_GUEST_SHMEM_LOC@ @QNX_GUEST_SHMEM_INTR@
}

[perms=0755] /scripts/block-start.sh = {
#!/bin/sh

echo "Starting virtio block ..."
# smem and irq must match the scratch virtio-blk vdev, which the host backs with
# the RAM disk it creates on its own boot line.
devb-virtio virtio smem=@QNX_GUEST_SCRATCH_LOC@,irq=@QNX_GUEST_SCRATCH_INTR@

waitfor /dev/hd0
/scripts/ramdisk-init.sh &
}

[perms=0755] /scripts/ramdisk-init.sh = {
#!/bin/sh

# First use of a fresh RAM disk: partition and format it. On a later run the
# partition is already there and this falls straight through to the mount.
if [ ! -e /dev/hd0t178 ]; then
    fdisk /dev/hd0 add -t178
    mount -e /dev/hd0
    waitfor /dev/hd0t178
    mkqnx6fs -q /dev/hd0t178
fi

mount -tqnx6 -o sync=none /dev/hd0t178 /ramdisk
}

[perms=0755] /scripts/watchdog-start.sh = {
#!/bin/sh

# Writing 3 to offset 8 enables the watchdog; the value at offset 0 is the
# timeout. Kick every second, timeout 3 seconds -- in practice 6, since the
# timer counts down twice and asserts the reset on the second expiry.
wdtkick -v -a @QNX_GUEST_WDT_LOC@ -t 1000 -E 8:3 -W 0:0x47868C0
}

[perms=0755] /scripts/watchdog-stop.sh = {
#!/bin/sh

# The check comes first, and deliberately -- this is the one place this script
# diverges from the reference guest's copy.
#
# Stopping the watchdog is two steps: slay the kicker, then clear the control
# register. Only the second actually disables the timer, so doing the first
# alone is worse than doing nothing: the timer keeps counting with nobody
# feeding it, and the guest resets a few seconds later.
#
# `io` is what writes the register, and it is not in the QNX 8 SDP -- the
# reference guest carries this script and not the binary, so running it there
# slays the kicker, fails on the next line, and resets the guest. Refusing up
# front is the honest behaviour.
if ! command -v io >/dev/null 2>&1; then
    echo "watchdog-stop: 'io' is not in this image, so the control register at"
    echo "               @QNX_GUEST_WDT_CTRL@ cannot be cleared."
    echo "               NOT slaying wdtkick: without the register write the"
    echo "               timer would keep counting and reset this guest."
    echo "               Stop the guest from the host instead, or add a utility"
    echo "               that can write a physical address."
    exit 1
fi

slay -f wdtkick
io 32 @QNX_GUEST_WDT_CTRL@ 0
}

################################################################################
## Name resolution.
##
## The host NATs this guest onto the outside world (pf-nat.conf in the host
## image), so routing works the moment the default route above is set -- and
## then every name lookup fails anyway, because nothing in this image supplies
## a resolver. The SDP contributes /etc/hosts, services and protocols and stops
## there, and there is no dhcpcd here: the address is static.
##
## The symptom reads as a routing fault and is not one:
##
##     # ping 8.8.8.8            -> replies
##     # ping www.google.com     -> cannot resolve: Name does not resolve
##
## Public resolvers rather than the host, which forwards nothing, or the LAN
## gateway, which is not reachable when the board's own uplink is the wifi on a
## different subnet.
################################################################################
[perms=0644] /etc/resolv.conf = {
@QNX_GUEST_RESOLV@
}

################################################################################
## Applications -- generated from QNX_IFS_INSTALL.
################################################################################
@QNX_IFS_FILES@

################################################################################
## Virtio drivers: this is how a guest sees the world. These three are the only
## thing that makes the shared block and network stacks below usable here -- a
## guest has no real hardware, so every device is a vdev the host provides.
################################################################################
/sbin/devc-virtio=devc-virtio
/sbin/devb-virtio=devb-virtio
# devs-, not devnp-: QNX 8 io-sock drivers use the devs- prefix; devnp- was
# the io-pkt naming.
/lib/dll/devs-vtnet_mmio.so=devs-vtnet_mmio.so

# The Screen display configurations and graphics-virtio-start.sh used to be
# listed here, pointed into the qnx-host-conf stage directory. They come from
# the qnx-guest-conf component now: reaching into the host component's staging
# meant installing the host component, and that carries the board's wifi PSK.

################################################################################
## Second copies of two Screen modules, in /usr/share/screen.
##
## qnx-screen already puts both in /lib/dll, which is where Screen dlopens them
## from by name. The reference guest carries them in BOTH places, and this
## reproduces that rather than assuming it was redundant: Screen resolves
## alloc-config and blit-config through its own search, /usr/share/screen is one
## of the directories it looks in, and a guest whose graphics-virtio-mmio.conf
## names alloc-virtio-virgl is not the case that proves /lib/dll is enough.
##
## The source has no leading slash and starts at dll/, so mkifs resolves it under
## a search root's lib/ -- the same spelling the reference uses.
################################################################################
/usr/share/screen/screen-stdbuf.so=dll/screen-stdbuf.so
/usr/share/screen/screen-sw.so=dll/screen-sw.so

# The rest of what the reference guest carries. A guest sees PCI through qvm's
# generic FDT host bridge, so it needs the bus module and the NIC drivers a
# passed-through device might be -- the same io-sock dlopen-by-name rule as on
# the host.
/lib/dll/mods-pci.so=mods-pci.so
/lib/dll/devs-em.so=devs-em.so
/lib/dll/devs-igc.so=devs-igc.so
/lib/dll/devs-ix.so=devs-ix.so
/lib/dll/devs-re.so=devs-re.so

# FAT, for reading a boot partition or a USB stick.
/lib/dll/fs-dos.so=fs-dos.so

/sbin/devb-ram=devb-ram
/sbin/devc-pty=devc-pty
# /sbin, which is where both reference images have it.
/sbin/sysctl=sysctl
/sbin/pfctl=pfctl
[+optional] /usr/sbin/if_up=if_up

# pci-server reads this. No [envars] section naming a hw module: under qvm the
# generic pci_hw-fdt is the right one and pci-server finds it by itself.
/etc/system/config/pci/pci_server.cfg = {
[buscfg]

[runtime]
BUS_SCAN_LIMIT=1

}
/etc/system/config/pci/pcidatabase.com-tab_delimited.txt=${QNX_TARGET}/etc/system/config/pci/pcidatabase.com-tab_delimited.txt

################################################################################
## The rest of the block stack, the network stack, and the base filesystem
## layout and utilities -- all identical to the host image, so all shared.
################################################################################
#include qnx-base.build.inc
