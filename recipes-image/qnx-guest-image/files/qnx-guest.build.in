################################################################################
## QNX hypervisor GUEST image -- TEMPLATE.
##
## Modelled on qnx_guests/images/guest-1/qnx800-guest-1.build.
##
## Note how little boot configuration appears here: a guest is loaded by qvm at
## a high address as ELF with the generic startup, which is exactly what
## meta-qnx defaults to. The host image had to override every one of those; this
## one overrides none.
##
## Everything unqualified resolves from $QNX_TARGET. Applications arrive through
## QNX_IFS_INSTALL in the recipe.
################################################################################

#include qnx-boot.build.inc

[+script] startup-script = {
#include qnx-startup-preamble.build.inc

    ############################################################################
    ## Console. The virtio-console vdev the host gives this guest -- loc and
    ## intr must match the guest's .qvmconf.
    ############################################################################
    devc-virtio @QNX_GUEST_CONSOLE@
    waitfor /dev/vcon1 4
    reopen /dev/vcon1

    display_msg " "
    ksh -c "echo Welcome to QNX $(uname -r) on $(uname -m)"
    display_msg " "

    ############################################################################
    ## Networking over virtio-net, to the host and to the other guest.
    ############################################################################
    display_msg "Starting networking ..."
    io-sock -m phy -m fdt -d vtnet_mmio
    waitfor /dev/socket 10

    # The other end of the host's vp0. The host routes and NATs this network,
    # so it is also the default gateway -- see .vdev_net_start.sh and pf.conf
    # in the host image.
    ifconfig vtnet0 @QNX_GUEST_IP@ netmask 255.255.255.0 up
    route add default @QNX_GUEST_GATEWAY@

    ############################################################################
    ## Data disk (rootfs.img) -- union-mounted at /.
    ##
    ## Everything too large for this RAM-resident IFS lives on a virtio-blk disk
    ## the host attaches: the Qt cluster deploy tree today, the graphics stack
    ## and SOME/IP libraries as they come online. Mounted here, before any of it
    ## is used, so every path resolves as if the files were baked into the image.
    ## A guest booted without the disk present logs an error and carries on.
    ############################################################################
    /proc/boot/.rootfs-mount.sh

    ############################################################################
    ## Applications, ordered by QNX_IFS_STARTUP_AFTER dependencies.
    ############################################################################
@QNX_IFS_STARTUP@

    display_msg "Starting shell ..."
    [+session] ksh &
}

[uid=0 gid=0]

################################################################################
## Mount the guest data disk (rootfs.img) at /.
##
## rootfs.img is attached by qnx-guest.qvmconf as a virtio-blk vdev. smem= and
## irq= here MUST match that vdev's loc/intr (0x1c0b0000 / gic:45). The whole
## device is the filesystem -- there is no partition table -- so it is mounted
## as /dev/vblk0 directly, not a /dev/vblk0tNNN partition.
##
## An external file would need a repo path; this is short and self-contained, so
## it is written inline. It contains no '}' or '${...}', which an inline mkifs
## block cannot carry.
################################################################################
[perms=0744] /proc/boot/.rootfs-mount.sh = {
#!/bin/ksh
echo "Starting virtio block driver for the data disk ..."
devb-virtio virtio smem=0x1c0b0000,irq=45 disk name=vblk

if waitfor /dev/vblk0 10
then
    mount -t qnx6 /dev/vblk0 /
    if test -f /qt-cluster/run.sh
    then
        echo "Data disk mounted at / (Qt cluster and payloads available)"
    else
        echo "ERROR: data disk mounted but /qt-cluster is missing -- rebuild rootfs.img"
    fi
else
    echo "ERROR: /dev/vblk0 never appeared -- is rootfs.img present next to the .qvmconf?"
fi
}

################################################################################
## Applications -- generated from QNX_IFS_INSTALL.
################################################################################
@QNX_IFS_FILES@

################################################################################
## Virtio drivers: this is how a guest sees the world. These three are the only
## thing that makes the shared block and network stacks below usable here -- a
## guest has no real hardware, so every device is a vdev the host provides.
################################################################################
/sbin/devc-virtio=devc-virtio
/sbin/devb-virtio=devb-virtio
# devs-, not devnp-: QNX 8 io-sock drivers use the devs- prefix; devnp- was
# the io-pkt naming.
/lib/dll/devs-vtnet_mmio.so=devs-vtnet_mmio.so

################################################################################
## The rest of the block stack, the network stack, and the base filesystem
## layout and utilities -- all identical to the host image, so all shared.
################################################################################
#include qnx-base.build.inc
