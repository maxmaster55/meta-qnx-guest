################################################################################
## QNX hypervisor GUEST image -- TEMPLATE.
##
## Modelled on qnx_guests/images/guest-1/qnx800-guest-1.build.
##
## Note how little boot configuration appears here: a guest is loaded by qvm at
## a high address as ELF with the generic startup, which is exactly what
## meta-qnx defaults to. The host image had to override every one of those; this
## one overrides none.
##
## Everything unqualified resolves from $QNX_TARGET. Applications arrive through
## QNX_IFS_INSTALL in the recipe.
################################################################################

[-optional]
[+keeplinked]
[image=@QNX_IMAGE_ADDR@]

[virtual=@QNX_IMAGE_VIRTUAL@] boot = {
    @QNX_STARTUP@ @QNX_STARTUP_ARGS@
    PATH=@QNX_IFS_PATH@ LD_LIBRARY_PATH=@QNX_IFS_LD_LIBRARY_PATH@ @QNX_KERNEL@ @QNX_KERNEL_ARGS@
}

[+script] startup-script = {
    SYSNAME=nto
    TERM=qansi

    procmgr_symlink ../../proc/boot/ldqnx-64.so.2 /usr/lib/ldqnx-64.so.2

    pipe
    slogger2
    dumper
    mqueue
    random

    ############################################################################
    ## Console. The virtio-console vdev the host gives this guest -- loc and
    ## intr must match the guest's .qvmconf.
    ############################################################################
    devc-virtio @QNX_GUEST_CONSOLE@
    waitfor /dev/vcon1 4
    reopen /dev/vcon1

    display_msg " "
    ksh -c "echo Welcome to QNX $(uname -r) on $(uname -m)"
    display_msg " "

    ############################################################################
    ## Networking over virtio-net, to the host and to the other guest.
    ############################################################################
    display_msg "Starting networking ..."
    io-sock -m phy -m fdt -d vtnet_mmio

    ############################################################################
    ## Applications, ordered by QNX_IFS_STARTUP_PRIORITY.
    ############################################################################
@QNX_IFS_STARTUP@

    display_msg "Starting shell ..."
    [+session] ksh &
}

[uid=0 gid=0]

[type=link] /bin/sh=/bin/ksh
[type=link] /tmp=/dev/shmem
[type=link] /dev/console=/dev/vcon1
[type=link] /var/log=/tmp
[type=link] /usr/tmp=/tmp

################################################################################
## Applications -- generated from QNX_IFS_INSTALL.
################################################################################
@QNX_IFS_FILES@

################################################################################
## Virtio drivers: this is how a guest sees the world.
################################################################################
/sbin/devc-virtio=devc-virtio
/sbin/devb-virtio=devb-virtio
# devs-, not devnp-: QNX 8 io-sock drivers use the devs- prefix; devnp- was
# the io-pkt naming.
/lib/dll/devs-vtnet_mmio.so=devs-vtnet_mmio.so

/lib/libcam.so=libcam.so
/lib/dll/io-blk.so=io-blk.so
/lib/dll/cam-disk.so=cam-disk.so
/lib/dll/fs-qnx6.so=fs-qnx6.so

################################################################################
## Networking
################################################################################
/sbin/io-sock=io-sock
/sbin/ifconfig=ifconfig
/sbin/route=route
[+optional] /sbin/dhcpcd=dhcpcd

################################################################################
## Base utilities. ls/cat/uname and friends arrive via toybox in the generated
## section above -- QNX 8 ships no standalone versions of them.
################################################################################
/bin/ksh=ksh
/bin/pidin=pidin
/bin/waitfor=waitfor
/bin/slay=slay
/bin/mount=mount
