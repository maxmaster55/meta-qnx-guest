# qvm configuration for this guest, read by the hypervisor host.
#
# Modelled on qnx_guests/images/guest-1/qnx-guest-1.qvmconf, trimmed to the
# devices the image built here actually drives.
#
# Every loc/intr below is a contract with the guest's startup script: the
# addresses are arbitrary but must match on both sides, because a guest with no
# PCI has no way to discover them.
#
# The at-sign placeholders below come from meta-qnx-guest/conf/qnx-guest-vdevs.inc
# and are expanded when this file is staged. Those are the addresses that more
# than one file has to agree on, so they are set in one place; edit them there,
# not here. Everything still written as a literal appears only in this file.
#
# (Spelled out in words rather than shown, because a placeholder written
# literally in a comment is still a placeholder to the expander, and an unset one
# is fatal.)
#
# The full map, because an interrupt used twice is a bug nobody finds by reading
# one stanza at a time -- this happened once already, when an entropy vdev was
# given gic:44 while the SPI pass-through below was still asking for it:
#
#   gic:37  pl011                 0x1c090000
#   gic:38  shmem                 0x1c050000
#   gic:39  virtio-gpu            0x1c0e0000
#   gic:40  virtio-net host       0x1c0c0000
#   gic:41  virtio-blk qvmdisk0   0x1c0d0000
#   gic:42  virtio-console        0x20000000
#   gic:43  virtio-net guest      0x20040000
#   gic:44  pass SPI0             mem:0x1f00050000  (host irq 179)
#   gic:45  virtio-blk rootfs     0x1c0b0000
#   gic:46  virtio-entropy        0x1c0a0000
#   gic:47  virtio-blk record     0x1c100000
#   gic:48  virtio-net lan        0x1c110000  (bridged; SOME/IP)
#           wdt-sp805             0x1c0f0000        (no interrupt)

system guest_1

# The IFS is RAM-resident, but the payloads that used to dominate this figure --
# the graphics stack and both Qt deploys -- now live on rootfs.img, so most of
# this is no longer strictly required.
#
# It stays at 2G deliberately, which is what the monorepo's guest-1 config says
# too: the Qt runtime and the virgl graphics buffers still want headroom, and
# shrinking it is a change worth testing on hardware on its own rather than
# taking as a side effect of something else.
ram @QNX_GUEST_RAM@

################################################################################
# Virtual CPUs.
#
# One "cpu" line per vCPU. The boot CPU runs at qvm's own priority; every AP
# after it runs HIGHER, and that asymmetry is the point -- startup's boot CPU
# spin-waits on a plain memory flag for each AP it powers on, in a loop that
# never traps, so an AP that cannot outrank it does not get scheduled and the
# guest comes up crippled or not at all.
#
# Set in meta-qnx-guest/conf/qnx-guest-vdevs.inc, explained at length there and
# in that layer's docs/vcpus.md. Do not "simplify" the two priorities into one.
@QNX_GUEST_CPUS@

# The guest boots the stock startup with no -P<n>, so it reads its CPU and GIC
# topology out of this FDT instead of probing for it.
fdt @QNX_GUEST_FDT@

# Relative to this file's directory, which is why the IFS is deployed beside it.
load qnx-guest.ifs

################################################################################
# Serial. Pointed at qvm's stdout so startup output is visible before the
# virtio console driver is up -- the startup driver writes here.
################################################################################
vdev pl011
        hostdev >-
        loc 0x1c090000
        intr gic:37

################################################################################
# The guest's main console. The same two values reach the guest's devc-virtio
# command line as QNX_GUEST_CONSOLE.
################################################################################
vdev virtio-console
        loc @QNX_GUEST_CONSOLE_LOC@
        intr gic:@QNX_GUEST_CONSOLE_INTR@

################################################################################
# THE ORDER OF THE TWO virtio-net VDEVS BELOW IS LOAD-BEARING.
#
# The guest enumerates them in REVERSE, so the one declared LAST becomes vtnet0
# and the one declared first becomes vtnet1. guest_to_host is therefore last,
# which is also the order the reference guest-1 config uses.
#
# Getting it backwards does not fail: the guest boots, both interfaces come up,
# and the boot script's addresses simply land on the wrong wires --
#
#     vtnet0  10.0.0.2   on the guest-to-guest link
#     vtnet1  10.0.2.1   on the host link
#
# -- so the host ARPs 10.0.0.2 into silence and every ssh to the guest times
# out, with nothing anywhere reporting an error. The MACs are what give it away:
# guest_to_host's mac appears on whichever interface it really is.
#
# The MMIO addresses are NOT the ordering key. They are identical to the
# reference's in both arrangements, which makes them a convincing red herring.
################################################################################

################################################################################
# Direct link to the Linux guest, bypassing the host's stack. Becomes vtnet1.
#
# Both ends name each other: this peers at /dev/qvm/guest_2/guest_to_guest and
# the Linux guest peers back at /dev/qvm/guest_1/guest_to_guest. `peer` is
# mandatory on a virtio-net vdev -- qvm refuses to start without it:
#
#     [qnx-guest.qvmconf:58] The `peer' option is mandatory
#
# The path is /dev/qvm/<system>/<vdev name>, so guest_2 here has to match the
# `system` line in linux.qvmconf (QNX_LINUX_GUEST_NAME in qnx-linux-guest).
#
# Neither guest has to start first: qvm resolves the peer lazily, so whichever
# comes up second completes the link.
################################################################################
################################################################################
# DECLARED FIRST so it becomes vtnet2. See the ordering note below -- the guest
# enumerates these in reverse, so the last declared is vtnet0.
#
# Bridged onto the physical NIC by the host (vp2 in .vdev_net_start.sh), which
# puts this guest on the same L2 segment as the head unit. SOME/IP service
# discovery is multicast and will not cross a routed boundary, which is why
# this exists alongside the routed guest_to_host link rather than instead of it.
################################################################################
vdev virtio-net
        loc @QNX_GUEST_LAN_LOC@
        intr gic:@QNX_GUEST_LAN_INTR@
        mac 00:aa:bb:cc:dd:03
        name guest_to_lan

vdev virtio-net
        loc 0x20040000
        intr gic:43
        peer /dev/qvm/guest_2/guest_to_guest
        peerfeats 0x00000000
        name guest_to_guest

################################################################################
# Networking to the host, over a vdevpeer the host binds with vpctl. Declared
# last, so it becomes vtnet0 -- see the note above.
################################################################################
vdev virtio-net
        loc 0x1c0c0000
        intr gic:40
        mac aa:bb:cc:dd:ee:f0
        name guest_to_host
        peer /dev/vdevpeers/vp0
        peerfeats 0x00000000

################################################################################
# Shared memory between guest and host. The frame router used to pass
# framebuffers through it; with that gone it is what /scripts/shmem-start.sh and
# shmem-guest demonstrate against, and it stays because the region name and size
# are what any future user of it would have to agree on anyway.
################################################################################
vdev shmem
        loc @QNX_GUEST_SHMEM_LOC@
        intr gic:@QNX_GUEST_SHMEM_INTR@
        create fb_shared,0x400000
        allow fb_shared

################################################################################
# The paravirtual GPU. This is what the guest's whole display depends on:
# drm-virtio attaches to it over the MMIO transport and QNX Screen then runs the
# Mesa virgl stack on top, so with no virtio-gpu here the guest has no GPU to
# find, /dev/dri/card0 never appears and the cluster never reaches the panel.
#
# loc and intr are read back by /scripts/graphics-virtio-start.sh, which passes
# them to drm-virtio as  -o virtio.device=<size>@<loc>:<intr>. That script lives
# in the qnx-host-conf repository and hardcodes them, so changing them here means
# changing them there too -- see the warning in qnx-guest-vdevs.inc.
#
# scanout-display is the host Screen display the guest is composited onto, and
# scanout-width/height must equal the physical panel, that display's video-mode
# in graphics-host-rpi5.conf, and the guest's own graphics-virtio-mmio.conf. The
# vdev scans out 1:1 with no scaling, so a mismatch puts the guest in a corner of
# the display rather than filling it.
################################################################################
vdev virtio-gpu
        loc @QNX_GUEST_GPU_LOC@
        intr gic:@QNX_GUEST_GPU_INTR@
        scanout-display @QNX_GUEST_SCANOUT_DISPLAY@
        scanout-width @QNX_GUEST_SCANOUT_WIDTH@
        scanout-height @QNX_GUEST_SCANOUT_HEIGHT@

################################################################################
# Entropy: without it the guest's random pool starves and anything using
# /dev/random blocks.
#
# Not at 0x1c0e0000/gic:44, which is where this landed when it was first added:
# that address is the virtio-gpu's and that interrupt is the SPI pass-through's.
################################################################################
vdev virtio-entropy
        loc 0x1c0a0000
        intr gic:46

################################################################################
# Guest data disk (rootfs.img).
#
# Holds everything too large for the RAM-resident IFS -- the Qt cluster deploy
# tree today, the virtio graphics stack and SOME/IP libraries as they come
# online. The guest union-mounts it at / early in boot via .rootfs-mount.sh, so
# those files keep the exact paths they would have had inside the IFS.
#
# hostdev is relative: qvm is launched from this file's directory, and the host
# disk build places rootfs.img right next to this .qvmconf (see the
# qnx-host-data bbappend in meta-qnx-guest). loc/intr MUST match the smem= and
# irq= arguments .rootfs-mount.sh passes to devb-virtio.
################################################################################
vdev virtio-blk
        loc @QNX_GUEST_ROOTFS_LOC@
        intr gic:@QNX_GUEST_ROOTFS_INTR@
        hostdev rootfs.img
        name virtio-blk_rootfs

################################################################################
# Scratch block device, backed by the RAM disk the host creates on its own boot
# line (devb-ram ... disk name=qvmdisk, so /dev/qvmdisk0 on the host side).
#
# Nothing mounts it automatically. It is what /scripts/block-start.sh in the
# guest demonstrates against, and the host creates the disk whether or not a
# guest claims it -- so without this stanza the host is publishing a device with
# no consumer, which is the state this file drifted into.
#
# The name is only for readability: it is what shows up in `pidin threads`.
################################################################################
################################################################################
# The recording volume: /record inside the guest.
#
# Backed by a file the HOST creates on its data partition at boot, not by
# anything the build produces -- see .record-create.sh in the host image and
# QNX_GUEST_RECORD_* in meta-qnx-guest/conf/qnx-guest-vdevs.inc.
#
# Separate from rootfs.img on purpose. Space inside rootfs.img is copied into
# the host data partition by mkqnx6fsimg on every build; space here is
# allocated once, on the card. It is also a block device in the guest, which is
# what lets it hold an expandable filesystem.
################################################################################
vdev virtio-blk
        loc @QNX_GUEST_RECORD_LOC@
        intr gic:@QNX_GUEST_RECORD_INTR@
        hostdev @QNX_GUEST_RECORD_IMG@
        name virtio-blk_record

vdev virtio-blk
        loc @QNX_GUEST_SCRATCH_LOC@
        intr gic:@QNX_GUEST_SCRATCH_INTR@
        hostdev /dev/qvmdisk0
        name virtio-blk_qvmdisk0

################################################################################
# Virtual watchdog. Driven by /scripts/watchdog-start.sh and watchdog-stop.sh in
# the guest, which have nothing to open without it. No interrupt: the SP805 model
# resets the guest rather than raising one.
################################################################################
vdev wdt-sp805
        loc @QNX_GUEST_WDT_LOC@

################################################################################
# Pass-through hardware.
#
# These are real RP1 register windows handed to the guest, which is why they are
# `pass` and not `vdev`: no model sits in between, the guest drives the silicon.
# The host must therefore not be driving the same blocks -- its own spi-dwc reads
# a config naming the same SPI0 base, so only one of the two may run at a time.
#
# `intr gic:44=179` maps the guest's interrupt 44 onto the host's 179, which is
# the Pi 5's SPI0 line. That is the mapping the host's spi.conf documents from
# the other side.
################################################################################

# SPI0 (RP1 SPI)
pass
        loc mem:0x1f00050000,0x1000,rwn
        intr gic:@QNX_GUEST_SPI_INTR@=179

# GPIO - io_bank0 (function select/control)
pass loc mem:0x1f000d0000,0x4000,rwn
# GPIO - rio0 (output/input data + atomic set/clr/xor)
pass loc mem:0x1f000e0000,0x4000,rwn
# GPIO - pads_bank0 (pull/drive/slew config)
pass loc mem:0x1f000f0000,0x4000,rwn

################################################################################
# SMMU. Needed for the pass-through windows above to do DMA safely -- without it
# a passed-through device sees host-physical addresses rather than the guest's.
################################################################################
vdev smmu
