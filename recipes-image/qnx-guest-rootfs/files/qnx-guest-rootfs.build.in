################################################################################
## Guest data disk (rootfs.img) -- mkqnx6fsimg TEMPLATE.
##
## A bare QNX6 filesystem the guest union-mounts at / over its RAM-resident IFS,
## via /proc/boot/.rootfs-mount.sh. The Yocto equivalent of
## qnx_guests/images/guest-1/rootfs.build.
##
## Everything here maps a staged tree (under @QNX_ROOTFS_SYSROOT@, filled by the
## recipe's QNX_ROOTFS_INSTALL) onto the target path the guest expects it at.
################################################################################

[num_sectors=@QNX_ROOTFS_SECTORS@]
[num_inodes=@QNX_ROOTFS_INODES@]
[blksize=@QNX_ROOTFS_BLKSIZE@]

[uid=0 gid=0 perms=0755]

################################################################################
## Qt Quick cluster -- the whole self-contained deploy tree (appCluster, run.sh,
## and the Qt libraries / QML modules / plugins / fonts it actually uses). Its
## run.sh resolves its own directory, so the tree relocates cleanly to /qt-cluster.
## Launch it from the guest with:  /qt-cluster/run.sh
################################################################################
/qt-cluster=@QNX_ROOTFS_SYSROOT@/qt-cluster

################################################################################
## Contributed by QNX_ROOTFS_EXTRA -- the graphics stack and SOME/IP libraries
## land here as they come online. Empty unless something sets it.
################################################################################
################################################################################
## The processor tree of everything in QNX_ROOTFS_INSTALL that stages one --
## qnx-screen-virtio puts drm-virtio and the virtio EGL/GLES stack under
## aarch64le/usr. The guest union-mounts this disk at /, so usr/bin here becomes
## /usr/bin there and drm-virtio is on PATH, which is what
## /scripts/graphics-virtio-start.sh needs.
##
## Mapped whole rather than file by file: the virtio graphics stack is ~279MB
## across several hundred files, and enumerating it here would be a list nobody
## could keep correct.
################################################################################
/usr=@QNX_ROOTFS_SYSROOT@/@QNX_PROCESSOR@/usr

@QNX_ROOTFS_EXTRA@
